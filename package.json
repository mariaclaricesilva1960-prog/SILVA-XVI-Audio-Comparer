{
  "name": "silva-xvi-audio-comparer",
  "version": "0.1.2",
  "private": true,
  "description": "Comparador de áudio e estúdio de treino vocal para Windows",
  "author": "SILVA XVI Audio Comparer",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "node scripts/prepare-pwa-assets.cjs && tsc --noEmit && vite build && node scripts/finalize-pwa.cjs",
    "build:pwa": "npm run build",
    "start": "cross-env NODE_ENV=production electron .",
    "package:win": "npm version patch --no-git-tag-version && npm run build && electron-builder --win nsis --x64 --publish never && node scripts/archive-update.cjs"
  },
  "build": {
    "appId": "com.silvaxvi.audiocomparer",
    "productName": "SILVA XVI Audio Comparer",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SILVA XVI Audio Comparer",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.2.6",
    "wait-on": "^8.0.3"
  }
}
